PORT=43124
WEB_ORIGIN=http://127.0.0.1:43123

# PostgreSQL (docker compose from repo root, or local install)
DATABASE_URL=postgresql://aps:aps_dev@127.0.0.1:5432/aps_lab

# JWT access token (simple strategy: access-only, no refresh in MVP)
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d

# Seeded ADMIN (npm run prisma:seed -w @aps/api). Never commit real secrets.
ADMIN_EMAIL=admin@example.com
ADMIN_USERNAME=admin
ADMIN_PASSWORD=ChangeMeAdmin1!
ADMIN_TIMEZONE=America/Mexico_City

# Optional: public web origin used when logging reset links in dev
WEB_PUBLIC_URL=http://127.0.0.1:43123
