PORT=43124
WEB_ORIGIN=http://127.0.0.1:43123

# PostgreSQL (docker compose from repo root, or local install)
DATABASE_URL=postgresql://aps:aps_dev@127.0.0.1:5432/aps_lab

# JWT access token (simple strategy: access-only, no refresh in MVP)
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d

# Seeded ADMIN (npm run prisma:seed -w @aps/backend). Never commit real secrets.
ADMIN_EMAIL=admin@example.com
ADMIN_USERNAME=admin
ADMIN_PASSWORD=ChangeMeAdmin1!
ADMIN_TIMEZONE=America/Mexico_City

# Optional: public web origin used when logging reset links in dev
WEB_PUBLIC_URL=http://127.0.0.1:43123

# Optional SMTP for forgot-password (nodemailer). If unset, link is logged.
# Example: smtp://user:pass@smtp.example.com:587
# SMTP_URL=
# MAIL_FROM=noreply@example.com

# Admin API = Bearer JWT of a user with role ADMIN (log in as the seeded admin).
# Optional static `x-admin-token` for scripts/CI only: disabled while unset;
# must be >= 24 chars (e.g. `openssl rand -hex 32`); `dev-admin-token` is rejected.
# ADMIN_TOKEN=
