# Copy values into backend/.env and frontend/.env.local as needed.
# See backend/.env.example for the full API set.

# --- backend (Nest) ---
PORT=43124
WEB_ORIGIN=http://127.0.0.1:43123
DATABASE_URL=postgresql://aps:aps_dev@127.0.0.1:5432/aps_lab
JWT_ACCESS_SECRET=dev-access-secret-change-me
JWT_ACCESS_TTL=7d
# Optional tooling secret for `x-admin-token` (unset = disabled; >= 24 chars)
# ADMIN_TOKEN=
ADMIN_EMAIL=admin@example.com
ADMIN_USERNAME=admin
# Seed passwords: required, set your own (min 8, upper + lower + number). Never commit them.
ADMIN_PASSWORD=
DEMO_PASSWORD=

# --- frontend (Next) ---
# Unset = same-origin /api/v1 via the Next proxy (no CORS preflight). Set only to bypass it.
# NEXT_PUBLIC_API_URL=http://127.0.0.1:43124/api/v1
