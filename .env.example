# Copy values into apps/api/.env and apps/web/.env.local as needed.
# See apps/api/.env.example for the full API set.

# --- apps/api ---
PORT=43124
WEB_ORIGIN=http://127.0.0.1:43123
DATABASE_URL=postgresql://aps:aps_dev@127.0.0.1:5432/aps_lab
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d
ADMIN_EMAIL=admin@example.com
ADMIN_USERNAME=admin
ADMIN_PASSWORD=ChangeMeAdmin1!
ADMIN_TIMEZONE=America/Mexico_City
WEB_PUBLIC_URL=http://127.0.0.1:43123

# --- apps/web ---
NEXT_PUBLIC_API_URL=http://127.0.0.1:43124/api/v1
